# ── Reasoning — pick the backend in config/aios.config.yaml `brain.backend` ──
# api (Commercial Terms; REQUIRED for resold clones — this deployment's own key):
ANTHROPIC_API_KEY=
# Set a HARD monthly spend limit on this key in the Anthropic console (cost Layer 1).
# claude_code (OWNER box only; token from `claude setup-token`):
CLAUDE_CODE_OAUTH_TOKEN=

# ── Ingress ──
# Drives the whole box through /dispatch. scripts/install.sh generates it if unset — before
# it did, a fresh box had an empty bearer, and an empty bearer refuses BOTH front doors.
DISPATCH_BEARER_TOKEN=
# The DASHBOARD password only. Leave blank and the dash accepts the bearer above, which is
# right for one operator on one box. Set it to something of its own the moment anyone who is
# not you logs in — showing a VA or a client the dashboard should not hand them the box.
DASH_TOKEN=
# Signs unsubscribe links (separate from the bearer: rotation must never break
# opt-out links in already-sent email). install_services.sh generates it.
UNSUB_SIGNING_KEY=

# ── Vendors ──
HEYGEN_API_KEY=
SCRAPECREATORS_API_KEY=
APOLLO_API_KEY=
HUNTER_API_KEY=
HUNTER_API_KEY2=
# Step-2 verified-email providers (FREE tiers; swappable via gtm.email_providers).
# Tomba = domain-search + free verifier (needs BOTH key + secret). Prospeo = enrich.
TOMBA_API_KEY=
TOMBA_API_SECRET=
PROSPEO_API_KEY=
INSTANTLY_API_KEY=

# ── Slack (clone bot: outbound notifier + Socket-Mode inbound) ──
SLACK_BOT_TOKEN=
# Socket Mode app-level token (xapp-…, scope connections:write):
SLACK_APP_TOKEN=
# Channel allowlist → intent map; UNLISTED channels are ignored by construction:
SLACK_CHANNEL_INTENTS=C0CHANNELID:reel
# Where the 8 AM morning drop + dashboard-born ready notices post:
REEL_SLACK_CHANNEL_ID=
OPERATOR_SLACK_USER_ID=

# ── Object storage (Litestream backup + finished-video delivery) ──
OBJECT_STORE_BUCKET=
OBJECT_STORE_ENDPOINT=
OBJECT_STORE_KEY=
OBJECT_STORE_SECRET=
# THE PUBLIC BASE every finished video and re-hosted article image is stamped with, e.g.
# https://media.your-domain.com. Read at UPLOAD time and then stored in the CMS forever, so
# it is the one value here that keeps being wrong long after you fix it: change it and the
# already-published URLs still carry the old host until somebody re-points them.
# LEFT EMPTY it does not fail — public_url() returns a ROOT-RELATIVE path ("/reels/x.mp4"),
# which renders on the box and breaks everywhere else. `python scripts/doctor.py` says which.
# Deliberately blank, like every other value here: this is YOUR media host, not ours.
OBJECT_STORE_PUBLIC_URL=

# ── Airtable — ONE Personal Access Token reaches every base ──
# THE KEY PROCESS: the PAT is the ONLY secret here; base IDs + table names are NOT secret
# (they live in config/aios.config.yaml `spaces:` and below). One key, many bases — the
# client targets a base per call, so this single token covers all three tables.
#
# Create ONE PAT at airtable.com/create/tokens with scopes:
#     data.records:read, data.records:write, schema.bases:read
#   (+ schema.bases:write ONLY if you want scripts/create_gtm_contacts_table.py to build
#    the GTM table for you — you can drop that scope afterward.)
# Grant it access to the SPECIFIC bases below — NOT "all workspaces" (base #3 holds PII).
# Verify any time:  python scripts/check_airtable.py --write
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=appREPLACEME          # default base (meet-mavrick VIDEOS); per-call base wins
AIRTABLE_VIDEOS_TABLE=VIDEOS
# bmacbuilds VIDEOS lives at base appREPLACEME (set in config spaces:) — same PAT.
# GTM contacts — the third table (emails + contact records, GoHighLevel-modeled). Set these
# once the base exists; create_gtm_contacts_table.py builds the table, then import your GHL CSV.
AIRTABLE_GTM_BASE_ID=
AIRTABLE_GTM_CONTACTS_TABLE=Contacts
# Airtable-native production trigger (optional — defaults shown). Set the single-
# select field below to the trigger value on a row to render it once from Airtable.
# AIRTABLE_RENDER_FIELD=Rendering
# AIRTABLE_RENDER_TRIGGER=Queue Production

# ── Auto Poster (Zernio) — social posting via the official SDK ──
# Set the key to turn it on (account ids auto-discover via the SDK). Flip the
# Airtable "Post" field to "Publish" on a READY reel to publish it (exactly-once).
ZERNIO_API_KEY=
# Optional (defaults shown): draft = stage in Zernio for review (safe); now = publish.
# AUTOPOST_DEFAULT_MODE=draft
# AUTOPOST_PLATFORMS=                 # blank = every connected account, e.g. "tiktok,instagram"
# AIRTABLE_POST_FIELD=Post
# AIRTABLE_POST_TRIGGER=Publish

# ── Ops ──
HEALTHCHECK_URL=
AIOS_DB_PATH=./aios.db
AIOS_PHYSICAL_ADDRESS=

# ── GTM outbound identity (W2.1 — REQUIRED before any send; no baked-in defaults) ──
# Sender identity on every outbound email. GTM_SENDER_NAME empty = sends REFUSE.
GTM_SENDER_NAME=
GTM_SENDER_TITLE=
GTM_COMPANY_NAME=
# The pitch's link target (drafts + click-stitching). Empty = drafts invite a reply.
GTM_CTA_URL=
# Verified Resend from-address + the monitored reply inbox.
GTM_FROM_EMAIL=
GTM_REPLY_TO=
# IMAP for reply ingestion (the drip REFUSES to send while this can't connect).
GTM_IMAP_HOST=
GTM_IMAP_USER=
GTM_IMAP_PASSWORD=
GTM_IMAP_FOLDER=INBOX

# The PUBLIC https address of this box. REQUIRED TO SEND EMAIL: every cold email carries a
# one-click unsubscribe link built from it, and send() refuses (fail-closed) while this is
# empty or not https — a relative opt-out link is a broken opt-out. Reel review links use it too.
# A laptop has no public address: sending needs the VPS path, or a tunnel (Cloudflare Tunnel).
DASHBOARD_BASE_URL=
